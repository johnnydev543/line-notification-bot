# === LINE Messaging API Credentials ===
# Get these from https://developers.line.biz/console/
# 1. Channel Access Token → LINE_CHANNEL_ACCESS_TOKEN
# 2. Channel Secret → LINE_CHANNEL_SECRET
# 3. Your LINE User ID → LINE_USER_ID
#    (Found in Channel → Basic settings, or send a message to the bot
#     and check the callback logs for your userId)

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=

# === Grafana Service Account Token (optional) ===
# Required only for the "alerts" bidirectional command.
# Create in Grafana → Administration → Service Accounts
# Role: Viewer (minimum)

GRAFANA_TOKEN=

# === Monitoring URLs (optional, defaults shown) ===
# GRAFANA_URL=http://grafana:3000
# PROMETHEUS_URLS=http://prometheus:9090

# === Logging (optional) ===
# LOG_LEVEL=INFO