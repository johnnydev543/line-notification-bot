# === LINE Messaging API Credentials ===
# Get these from https://developers.line.biz/console/
# 1. Channel Access Token → LINE_CHANNEL_ACCESS_TOKEN
# 2. Channel Secret → LINE_CHANNEL_SECRET
# 3. Push target(s): one or more LINE User/Group IDs.
#    - LINE_TARGET_IDS supports multiple, comma-separated: "U123,U456"
#    - LINE_USER_ID (legacy, single) still works if LINE_TARGET_IDS is empty.

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TARGET_IDS=
# LINE_USER_ID=

# === Integrations ===
# Grafana / Prometheus is an optional integration ("monitoring").
# Leave ENABLED_INTEGRATIONS empty to enable all discovered integrations,
# or restrict with a comma-separated list: monitoring,generic
# ENABLED_INTEGRATIONS=

# Monitoring outbound commands ("status"/"alerts") are opt-in: set GRAFANA_URL
# to enable them. Leaving it empty keeps the bot free of monitoring wiring
# (the inbound /webhook/monitoring endpoint still works).
# GRAFANA_URL=http://grafana:3000
# GRAFANA_TOKEN=   # needed for the "alerts" command only
# PROMETHEUS_URLS=http://prometheus:9090

# === Generic /notify endpoint security ===
# Shared secret; clients must send "Authorization: Bearer <secret>".
# Leave empty ONLY on fully trusted internal networks.
NOTIFY_SECRET=

# === Logging / server (optional) ===
# LOG_LEVEL=INFO
# PORT=5000
# TZ=Asia/Taipei
# LINE_MAX_TEXT_LENGTH=4800